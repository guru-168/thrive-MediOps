# Copy to backend/.env and adjust as needed. All values shown are the
# built-in defaults (see app/core/config.py) - the app runs fine with no
# .env file at all.

# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the trained model artifact lives. See app/ml/README.md.
MODEL_PATH=app/ml/model.joblib

# Operational risk-BAND cutoffs applied to the 0-1 risk_score (the
# low/moderate/high badge). Matches D:\Thrive Ml\src\api.py's
# get_risk_category() exactly.
RISK_THRESHOLD_LOW=0.40
RISK_THRESHOLD_HIGH=0.70

# The model's own locked decision threshold (selected on validation F1 -
# see D:\Thrive Ml\outputs\calibrated_threshold_config.json). Drives
# intervention_required ONLY - independent of the risk-band cutoffs
# above. See backend/app/ml/README.md for why these are kept separate.
INTERVENTION_THRESHOLD=0.22

# Max patients accepted per POST /patients/rank call.
MAX_BATCH_SIZE=500
