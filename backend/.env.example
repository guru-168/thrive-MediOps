# Copy to backend/.env for local development. All values shown are the
# built-in defaults (see app/core/config.py) - the app runs fine with no
# .env file at all. In production set these as the host's environment
# variables instead of shipping a .env file.

# Origins allowed to call this API, comma-separated. Defaults cover the
# local Vite dev server only.
# PRODUCTION: set this to the deployed frontend's exact origin, scheme
# included and no trailing slash, e.g.
#   ALLOWED_ORIGINS=https://mediops.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Regex for origins that cannot be listed up front - in practice
# Vercel preview deployments, whose hostname changes per branch/commit.
# Unset by default. Anchor it and escape the dots; never make it match any
# host. Example:
#   ALLOWED_ORIGIN_REGEX=^https://mediops-[a-z0-9-]+\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# Port to bind. Most PaaS hosts inject this automatically - the Dockerfile
# reads $PORT and binds 0.0.0.0, so normally you do not set this yourself.
PORT=8000

# Where the trained model artifact lives. The default is absolute and
# derived from the package location, so it is correct regardless of the
# working directory - prefer leaving this unset. Only override it with an
# ABSOLUTE path; a relative path breaks whenever the process starts from a
# different directory.
# MODEL_PATH=/app/app/ml/model.joblib

# Operational risk-BAND cutoffs applied to the 0-1 risk_score (the
# low/moderate/high badge). Matches the source model's get_risk_category().
RISK_THRESHOLD_LOW=0.40
RISK_THRESHOLD_HIGH=0.70

# The model's own locked decision threshold (selected on validation F1).
# Drives intervention_required ONLY - independent of the risk-band cutoffs
# above. See backend/app/ml/README.md for why these are kept separate.
INTERVENTION_THRESHOLD=0.22

# Max patients accepted per POST /patients/rank call.
MAX_BATCH_SIZE=500
