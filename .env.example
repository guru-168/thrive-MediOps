# Copy to .env.local for local development (Vite auto-loads it and it is
# git-ignored). In production these are set in the hosting provider's
# environment-variable settings instead.
#
# IMPORTANT: Vite inlines every VITE_* value at BUILD time, so changing
# any of these in your host's dashboard requires a REDEPLOY to take
# effect - restarting is not enough.

# Public URL of the prediction API (the FastAPI service in backend/).
# Local dev:  http://localhost:8000
# Production: the deployed API's public HTTPS origin, no trailing slash,
#             e.g. https://mediops-api.up.railway.app
# Must be https:// when the frontend is served over HTTPS, or the browser
# will block the request as mixed content.
VITE_API_URL=http://localhost:8000

# Supabase project URL and PUBLISHABLE (anon) key - used for auth only.
# These are safe to expose in a browser bundle. Never put the
# service_role/secret key here: it bypasses Row Level Security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
