# Copy to .env.local (Vite auto-loads it, and it's git-ignored by default
# via *.local) and adjust as needed.

# Base URL of the backend API (see backend/README.md). Never hard-code
# localhost in a component - src/services/api.ts reads this instead.
VITE_API_URL=http://localhost:8000

# Supabase Authentication & Storage configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
