# Copy this file to .env (which is gitignored) and fill in your real
# Supabase project values. Only the public URL and the publishable
# (anon) key belong here - never the secret/service_role key.
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
